<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <RootNamespace>XianAuth</RootNamespace>
    <AssemblyName>XianAuth</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\xian-auth.ico</ApplicationIcon>
    <Description>闲·认证设置界面</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XianAuth.Platform\XianAuth.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\xian-auth.png">
      <LogicalName>XianAuth.icon.png</LogicalName>
    </EmbeddedResource>
    <Content Include="..\..\assets\xian-auth.ico">
      <Link>xian-auth.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\xian-auth.png">
      <Link>xian-auth.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
